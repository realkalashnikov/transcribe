# ========================================================
# TRANSCRIBE STUDIO - CONFIGURAÇÕES DA INSTÂNCIA
# ========================================================

# Modo da Instância:
# - 'private': Uso pessoal ou equipe fechada (exige ACCESS_PIN se configurado, histórico salvo localmente)
# - 'public': Aberto estilo Cobalt (sessões isoladas efêmeras, histórico expira em 1h, sem vazamento entre visitantes)
# - 'byok': Nuvem aberta estilo Bring-Your-Own-Key (visitante usa sua própria chave de API)
INSTANCE_MODE=private

# Nome exibido na interface pública
INSTANCE_NAME=Transcribe Studio

# PIN de Acesso numérico ou senha mestra (obrigatório se INSTANCE_MODE=private e desejar proteger acesso remoto)
ACCESS_PIN=

# ========================================================
# ESCUDO ANTI-ABUSO & LIMITES DE RECURSOS
# ========================================================

# Duração máxima permitida por áudio em segundos (ex: 300 = 5 minutos)
# Em instâncias públicas protege o tempo de GPU/CPU do host
MAX_AUDIO_DURATION_SECONDS=300

# Tamanho máximo do arquivo de upload em megabytes
MAX_UPLOAD_SIZE_MB=50

# Número máximo de transcrições simultâneas em segundo plano (evita sobrecarga de VRAM/RAM)
MAX_CONCURRENT_JOBS=2

# Limite geral de requisições por minuto por IP/Sessão
RATE_LIMIT_PER_MINUTE=30

# Limite de transcrições por minuto por IP/Sessão
TRANSCRIBE_RATE_LIMIT_PER_MINUTE=5

# Tempo em minutos para expirar e deletar arquivos de histórico e áudio em modo público (garantia de privacidade e disco)
CLEANUP_EXPIRE_MINUTES=60

# ========================================================
# CHAVES DE API EM NUVEM (OPCIONAIS)
# ========================================================
# Podem ser definidas aqui globalmente pelo host ou inseridas na interface pelo próprio usuário
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
